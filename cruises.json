function parseIso(v){const d=new Date(v);return isNaN(d)?null:d}
const midnight=d=>new Date(d.getFullYear(),d.getMonth(),d.getDate());
// 크루즈 일정 전체를 받아 두고, 고른 날짜(state.cdate)에 영도에 머무는 배만 보여줌
let ALLC=[];
const ymdOf=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
function setCruiseDate(ds){
  state.cdate=ds;const base=new Date(ds+"T00:00"),next=new Date(+base+864e5);
  const pick=ALLC.filter(c=>c.a<next&&c.d>base);
  const m=d=>Math.round((d-base)/6e4);
  CRUISES=pick.map((c,i)=>({id:"d"+ds.replace(/-/g,"")+"_"+i,name:c.name,arr:Math.max(0,m(c.a)),dep:m(c.d),pax:c.pax,date:""}));
  cruiseSrc=pick.length?"apiDate":"apiNone";
  if(!CRUISES.some(c=>c.id===state.ship))state.ship=null;
}
function arrivalDates(){ // 오늘 이후 영도 입항일 (중복 없이)
  const t=ymdOf(new Date());return [...new Set(ALLC.map(c=>ymdOf(c.a)))].filter(d=>d>=t);
}
async function loadCruises(){
  try{
    const ctl=new AbortController();setTimeout(()=>ctl.abort(),5000);
    // cruises.json을 못 읽으면(파일로 바로 열었을 때 등) 이 파일 안에 넣어둔 일정을 씀
    let rows=CRUISES_INLINE;
    try{const res=await fetch(CRUISE_API+"?v="+Date.now(),{signal:ctl.signal});if(res.ok){const j=await res.json();if(Array.isArray(j)&&j.length)rows=j}}catch(e){}
    ALLC=rows.map(r=>({name:String(r.name||"").trim(),a:parseIso(r.arrive),d:parseIso(r.depart),pax:+r.pax||2000}))
      .filter(c=>c.name&&c.a&&c.d&&c.d>c.a).sort((x,y)=>x.a-y.a);
    if(!ALLC.length)return;
    const today=ymdOf(new Date());
    const hasToday=ALLC.some(c=>ymdOf(c.a)<=today&&ymdOf(c.d)>=today);
    setCruiseDate(hasToday?today:(arrivalDates()[0]||ymdOf(ALLC[ALLC.length-1].a)));
    if(state.screen==="q")render();
  }catch(e){}
}


